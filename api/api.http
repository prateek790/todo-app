@api_HostAddress = https://localhost:7228

# Register a new regular user. The password is stored as a one-way hash.
POST {{api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "name": "Taylor Reed",
  "email": "taylor@example.com",
  "mobile": "5551234567",
  "gender": "Non-binary",
  "dob": "1995-04-12",
  "password": "ReplaceWithYourStrongPassword"
}

###

# Create a user password once using the local provisioning key configured in user-secrets.
POST {{api_HostAddress}}/api/auth/provision-password
Content-Type: application/json

{
  "email": "ankit@gmail.com",
  "password": "ReplaceWithYourStrongPassword",
  "provisioningKey": "ReplaceWithYourProvisioningKey"
}

###

# @name login
POST {{api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "ankit@gmail.com",
  "password": "ReplaceWithYourStrongPassword"
}

###

@accessToken = {{login.response.body.accessToken}}

GET {{api_HostAddress}}/api/auth/me
Authorization: Bearer {{accessToken}}
Accept: application/json

###

POST {{api_HostAddress}}/api/auth/logout
Authorization: Bearer {{accessToken}}

###

GET {{api_HostAddress}}/api/users
Authorization: Bearer {{accessToken}}
Accept: application/json

###

GET {{api_HostAddress}}/api/users/1
Authorization: Bearer {{accessToken}}
Accept: application/json

###

POST {{api_HostAddress}}/api/users
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Taylor Reed",
  "email": "taylor@example.com",
  "mobile": "5551234567",
  "gender": "Non-binary",
  "dob": "1995-04-12T00:00:00",
  "isActive": true,
  "range": [2, 8],
  "userType": "User"
}

###

PUT {{api_HostAddress}}/api/users/2
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Taylor Morgan",
  "email": "taylor@example.com",
  "mobile": "5551234567",
  "gender": "Non-binary",
  "dob": "1995-04-12T00:00:00",
  "isActive": true,
  "range": [2, 8],
  "userType": "User"
}

###

DELETE {{api_HostAddress}}/api/users/2
Authorization: Bearer {{accessToken}}
